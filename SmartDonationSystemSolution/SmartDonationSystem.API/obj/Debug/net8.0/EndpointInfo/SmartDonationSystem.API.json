  "components": {
    "schemas": {
      "ChangePasswordRequestDto": {
        "required": [
          "newPassword",
          "oldPassword"
        ],
        "type": "object",
        "properties": {
          "oldPassword": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateCommentDto": {
        "required": [
          "content",
          "postId"
        ],
        "type": "object",
        "properties": {
          "content": {
            "minLength": 1,
            "type": "string"
          },
          "postId": {
            "type": "integer",
            "format": "int32"
          },
          "parentCommentId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "mentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "required": [
          "identityNumber",
          "password"
        ],
        "type": "object",
        "properties": {
          "identityNumber": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PostSortBy": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "RegisterRequestDto": {
        "required": [
          "birthDate",
          "fullName",
          "identityNumber",
          "password",
          "phoneNumber",
          "profilePictureUrl",
          "role"
        ],
        "type": "object",
        "properties": {
          "identityNumber": {
            "maxLength": 14,
            "minLength": 0,
            "type": "string"
          },
          "fullName": {
            "minLength": 1,
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "profilePictureUrl": {
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateCategoryDto": {
        "required": [
          "newCategoryName",
          "oldCategoryId"
        ],
        "type": "object",
        "properties": {
          "oldCategoryId": {
            "type": "integer",
            "format": "int32"
          },
          "newCategoryName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateCommentDto": {
        "required": [
          "content"
        ],
        "type": "object",
        "properties": {
          "content": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "mentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateUserRequestDto": {
        "required": [
          "address",
          "birthDate",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "phoneNumber": {
            "minLength": 1,
            "type": "string"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  }
